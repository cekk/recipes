# === GitHub (storage ricette) ===
# Crea un repo su GitHub e un Personal Access Token con permessi "Contents: Read & Write"
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=cekk/recipes
GITHUB_BRANCH=main

# === Google Gemini ===
# Ottieni una chiave gratuita su https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxx

# === Sicurezza ===
# Scegli una chiave segreta lunga e casuale
API_KEY=cambia-questa-chiave-segreta

# === Telegram Bot (opzionale) ===
# Crea un bot con @BotFather e ottieni il token
TELEGRAM_BOT_TOKEN=
# Il tuo Telegram User ID (ottienilo con @userinfobot)
TELEGRAM_ALLOWED_USER_ID=0
