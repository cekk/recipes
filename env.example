# === GitHub (storage ricette) ===
# Crea un repo su GitHub e un Personal Access Token con permessi "Contents: Read & Write"
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=cekk/recipes
GITHUB_BRANCH=main

# === Google Gemini ===
# Ottieni una chiave gratuita su https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxx

# === Sicurezza ===
# Scegli una chiave segreta lunga e casuale (utilizzata dal bot Telegram e dagli script)
API_KEY=cambia-questa-chiave-segreta

# === Google OAuth (Backend) ===
# Crea un Client ID su https://console.cloud.google.com/apis/credentials
# Tipo: Applicazione Web. Origini JS autorizzate: http://localhost:5173 + dominio Render
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
# Email autorizzate a scrivere (separate da virgola) — verificate server-side
ALLOWED_EMAILS=tuo@gmail.com

# === Google OAuth (Frontend / Vite) ===
# Stesso Client ID — letto da Vite al momento del build
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
# Stessa lista email — usata per nascondere i controlli di scrittura agli utenti non autorizzati
VITE_ALLOWED_EMAILS=tuo@gmail.com

# === Telegram Bot (opzionale) ===
# Crea un bot con @BotFather e ottieni il token
TELEGRAM_BOT_TOKEN=
# Il tuo Telegram User ID (ottienilo con @userinfobot)
TELEGRAM_ALLOWED_USER_ID=0
